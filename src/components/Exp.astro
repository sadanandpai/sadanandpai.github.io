---
import { experience } from "../config.ts";
---

<section class="resume section-card" id="experience">
  <header class="section-heading">
    <div>
      <h2 class="article-title">Career journey and foundation</h2>
    </div>
  </header>

  <div class="timeline-grid">
    <section class="timeline">
      <div class="title-wrapper">
        <div class="icon-box">
          <ion-icon name="briefcase-outline"></ion-icon>
        </div>

        <h3 class="h3">Professional</h3>
      </div>

      <ol class="timeline-list">
        {
          experience.professional.map((exp) => (
            <li class="timeline-item">
              <div class="timeline-item-header">
                <h4 class="h4 title">{exp.name}</h4>
                <span class="duration">{exp.duration}</span>
              </div>
              <span class="role">{exp.role}</span>
              <ul class="timeline-description-list">
                {(Array.isArray(exp.description)
                  ? exp.description
                  : [exp.description]
                )
                  .filter(Boolean)
                  .map((description) => (
                    <li class="timeline-description-item" set:html={description} />
                  ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="timeline">
      <div class="title-wrapper">
        <div class="icon-box">
          <ion-icon name="school-outline"></ion-icon>
        </div>
        <h3 class="h3">Education</h3>
      </div>

      <ol class="timeline-list">
        {
          experience.education.map((edu) => (
            <li class="timeline-item">
              <div class="timeline-item-header">
                <h4 class="h4 title">{edu.name}</h4>
                <span class="duration">{edu.duration}</span>
              </div>
              <p class="timeline-text">{edu.college}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</section>

<style>
  .resume {
    display: grid;
    gap: clamp(1.2rem, 2vw, 1.8rem);
  }

  .timeline-grid {
    display: grid;
    gap: 1rem;
  }

  .timeline {
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
  }

  .timeline-list {
    margin-left: 2rem;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 1rem;
  }

  .timeline-item:not(:last-child) {
    margin-bottom: 1rem;
  }

  .timeline-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
    flex-wrap: wrap;
  }

  .title {
    font-size: var(--fs-5);
    line-height: 1.35;
    font-weight: var(--fw-600);
    color: var(--text-primary);
  }

  .duration {
    color: var(--text-muted);
    font-size: var(--fs-8);
    font-weight: var(--fw-600);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .role {
    color: var(--vegas-gold);
    font-size: var(--fs-7);
    font-weight: var(--fw-600);
    line-height: 1.4;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .timeline-item:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 0.2rem;
    left: -1.12rem;
    width: 1px;
    height: calc(100% + 0.85rem);
    background: var(--border-subtle);
  }

  .timeline-item::after {
    content: "";
    position: absolute;
    top: 0.26rem;
    left: -1.35rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .timeline-text {
    color: var(--text-secondary);
    font-weight: var(--fw-300);
    font-size: var(--fs-7);
    line-height: 1.65;
  }

  .timeline-description-list {
    margin-top: 0.3rem;
    padding-left: 1rem;
    display: grid;
    gap: 0.38rem;
  }

  .timeline-description-list:empty {
    display: none;
  }

  .timeline-description-item {
    display: list-item;
    list-style-type: disc;
    list-style-position: outside;
    color: var(--text-secondary);
    font-size: var(--fs-7);
    font-weight: var(--fw-300);
    line-height: 1.62;
  }

  .timeline-description-item::marker {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .timeline {
      padding: 1.25rem;
    }

    .timeline-grid {
      gap: 1.15rem;
    }

    .timeline-list {
      margin-left: 2.2rem;
    }
  }

</style>
