---
import { work } from "../config.ts";
---

<article class="portfolio" data-page="work">
  <header>
    <h2 class="h2 article-title">Work</h2>
  </header>

  <section class="categories">
    <ul class="items-list">
      {
        Object.keys(work).map((category) => (
          <li class="category">
            <button data-filter-btn={category}>{category}</button>
          </li>
        ))
      }
    </ul>

    <div>
      {
        Object.entries(work).map(([category, group]) => (
          <ul
            class="project-list"
            data-category={category}
            data-view={group.view}
          >
            {group.items.map((item) => (
              <li class="project-item">
                <a href={item.link} target="_blank" rel="noopener noreferrer">
                  <figure class="project-img">
                    <img src={item.pic} alt={item.name} loading="lazy" />
                  </figure>

                  <div class="project-info">
                    <h3 class="project-title">{item.name}</h3>
                    {group.view === "list" && "description" in item && (
                      <>
                        <p class="project-description">{item.description}</p>
                        {item.tags && item.tags.length > 0 && (
                          <ul class="project-tags">
                            {item.tags.map((tag) => (
                              <li class="project-tag">{tag}</li>
                            ))}
                          </ul>
                        )}
                      </>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>
</article>

<style>
  .items-list {
    display: flex;
    gap: 1rem;
    color: var(--white-2);
  }

  .category {
    margin-bottom: 2rem;

    button {
      color: var(--white-2);
      text-transform: capitalize;
    }

    button.active {
      color: var(--orange-yellow-crayola);
    }
  }

  .select-value {
    text-transform: capitalize;
  }

  .project-list {
    margin-bottom: 10px;
  }

  /* Shared item hover effects */
  .project-list a {
    color: inherit;
    display: block;
  }

  .project-list a:hover .project-img::before {
    background-color: var(--image-overlay);
  }

  .project-item > a:hover img {
    transform: scale(1.05);
  }

  .project-img {
    position: relative;
    border-radius: 16px;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: var(--transition-1);
      display: block;
    }

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: transparent;
      z-index: 1;
      transition: var(--transition-1);
    }
  }

  .project-title {
    color: var(--white-2);
    font-size: 15px;
    font-weight: 500;
    text-transform: capitalize;
    line-height: 1.3;
  }

  /* ---------- GRID VIEW (blogs) ---------- */
  .project-list[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px;
  }

  .project-list[data-view="grid"] .project-img {
    height: 230px;
    width: 100%;
    margin-bottom: 15px;
  }

  /* ---------- LIST VIEW (projects) ---------- */
  .project-list[data-view="list"] {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-list[data-view="list"] .project-item > a {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-gradient-jet);
    border: 1px solid var(--jet);
    border-radius: 14px;
    padding: 14px;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--transition-1),
      box-shadow var(--transition-1);
  }

  .project-list[data-view="list"] .project-item > a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .project-list[data-view="list"] .project-img {
    flex-shrink: 0;
    width: 120px;
    height: 90px;
    border-radius: 10px;
  }

  .project-list[data-view="list"] .project-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .project-list[data-view="list"] .project-title {
    font-size: var(--fs-4);
  }

  .project-description {
    color: var(--light-gray);
    font-size: var(--fs-6);
    font-weight: var(--fw-300);
    line-height: 1.55;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .project-tag {
    color: var(--orange-yellow-crayola);
    background: var(--onyx);
    border: 1px solid var(--jet);
    border-radius: 999px;
    font-size: var(--fs-8);
    padding: 3px 10px;
    line-height: 1.4;
  }

  @media (max-width: 579px) {
    .project-list[data-view="list"] .project-item > a {
      flex-direction: column;
    }

    .project-list[data-view="list"] .project-img {
      width: 100%;
      height: 160px;
    }
  }
</style>

<script>
  type WorkView = "list" | "grid";

  const categories = ["projects", "blogs"] as const;
  const selectedValue = categories[0];
  const portfolio = document.querySelector<HTMLElement>(".portfolio");
  const itemsListContainer = document.querySelector<HTMLElement>(".items-list");
  const categoriesElements = categories
    .map((c) => document.querySelector<HTMLElement>(`[data-category="${c}"]`))
    .filter((element): element is HTMLElement => element !== null);

  const resolveDisplay = (view: WorkView | undefined): string => {
    if (view === "list") {
      return "flex";
    }
    return "grid";
  };

  const filterCategory = (category: string) => {
    categoriesElements.forEach((c) => (c.style.display = "none"));
    const categorySection = document.querySelector<HTMLElement>(
      `[data-category="${category.toLowerCase()}"]`
    );
    if (categorySection) {
      const view = categorySection.dataset.view as WorkView | undefined;
      categorySection.style.display = resolveDisplay(view);
    }
  };

  if (portfolio && itemsListContainer) {
    itemsListContainer.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const button = target.closest<HTMLButtonElement>(
        "button[data-filter-btn]"
      );
      if (!button) {
        return;
      }

      filterCategory(button.innerText);
      portfolio.querySelector(".active")?.classList.remove("active");
      button.classList.add("active");
    });

    filterCategory(selectedValue);
    const defaultButton = portfolio.querySelector<HTMLButtonElement>(
      `button[data-filter-btn="${selectedValue}"]`
    );
    defaultButton?.classList.add("active");
  }
</script>
